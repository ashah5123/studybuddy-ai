# Local app URL — use this for OAuth redirects (Google sign-in, etc.)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase (from your Supabase project settings → API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# AI chat (server-only; get a key from https://console.groq.com/)
GROQ_API_KEY=
# Optional — text-only chat (default: llama-3.3-70b-versatile)
# GROQ_MODEL=
# Used when messages include images (default: meta-llama/llama-4-scout-17b-16e-instruct)
# GROQ_VISION_MODEL=
